#!/usr/bin/env bash

set -eu

source "$(dirname "$(realpath "${0}")")"/../global-vars.inc.bash

source "${PROJECT_PATH}"/bin/docker/docker-interactive-parameter.inc.bash
source "${PROJECT_PATH}"/bin/docker.inc.bash

docker pull "${DOCKER_PHP_DEV_IMAGE_NAME}"
docker pull "${DOCKER_PHP_CI_IMAGE_NAME}"

readonly DOCKER_CONTAINER_NAME=tekkenpedia_nginx

readonly containers=$(docker ps -q --filter name="${DOCKER_CONTAINER_NAME}")
if [ "${containers}" != "" ]; then
    docker stop ${containers}
fi

docker \
    run \
        --rm \
        ${DOCKER_INTERACTIVE_PARAMETER} \
        ${DOCKER_TTY_PARAMETER} \
        --mount type=bind,source="${PROJECT_PATH}",target=/app \
        --mount type=bind,source="${PROJECT_PATH}"/docker/nginx/vhost.conf,target=/etc/nginx/conf.d/default.conf \
        --detach \
        --name "${DOCKER_CONTAINER_NAME}" \
        --publish 80:80 \
        nginx:1.29.0-alpine3.22
