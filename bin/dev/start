#!/usr/bin/env bash

set -eu

source "$(dirname "$(realpath "${0}")")"/../global-vars.inc.bash

source "${PROJECT_PATH}"/bin/docker/docker-interactive-parameter.inc.bash

docker \
    run \
        --rm \
        ${DOCKER_INTERACTIVE_PARAMETER} \
        ${DOCKER_TTY_PARAMETER} \
        --mount type=bind,source="${PROJECT_PATH}",target="${PROJECT_PATH}" \
        --mount type=bind,source="$(which docker)",target=/usr/bin/docker \
        --mount type=bind,source=/var/run/docker.sock,target=/var/run/docker.sock \
        --workdir "${PROJECT_PATH}" \
        steevanb/php-parallel-processes:1.1.0-alpine \
        php \
            bin/dev/start.php \
            "${@}"
