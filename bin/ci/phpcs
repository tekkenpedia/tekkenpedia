#!/usr/bin/env bash

set -eu

source "$(dirname "$(realpath "${0}")")"/../global-vars.inc.bash

source "${PROJECT_PATH}"/bin/ci/dockerise.inc.bash

if [ ! -d "${PROJECT_PATH}"/var/ci/phpcs ]; then
    mkdir -p "${PROJECT_PATH}"/var/ci/phpcs
fi

phpcs \
    -p \
    --warning-severity=0 \
    --ignore=/var/,/vendor/ \
    --bootstrap=config/ci/phpcs.php \
    --standard="${COMPOSER_HOME}"/vendor/steevanb/php-code-sniffs/src/Steevanb/ruleset.xml \
    --report=steevanb\\PhpCodeSniffs\\Reports\\Steevanb \
    --cache="${PROJECT_PATH}"/var/ci/phpcs/cache \
    "${PROJECT_PATH}" \
    "${@:-}"
