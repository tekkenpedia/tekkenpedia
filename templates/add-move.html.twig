<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>TekkenPedia</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
        <link href="styles/styles.css" rel="stylesheet">
        <link rel="icon" type="image/png" href="images/favicon.png" />
    </head>
    <body>
        <div class="container">
            {% set breadcrumb = [
                {
                    "href": ".",
                    "label": "TekkenPedia"
                },
                {
                    "label": "Add move"
                }
            ] %}
            {% include 'breadcrumb.html.twig' with {breadcrumb: breadcrumb} only %}

            <div class="row">
                <div class="col-12">
                    <form>
                        <div class="row mb-3">
                            <label for="inputs" class="col-sm-2 col-form-label">Token</label>
                            <div class="col-sm-10">
                                <input class="form-control" id="token" placeholder="Example: github_pat_11..." required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="property" class="col-sm-2 col-form-label">Character</label>
                            <div class="col-sm-10">
                                <select id="character" class="form-select" required>
                                    <option value=""></option>
                                    {% for character in characters.toArray() %}
                                        <option value="{{ character.slug }}">{{ character.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="inputs" class="col-sm-2 col-form-label">Inputs</label>
                            <div class="col-sm-10">
                                <input class="form-control" id="inputs" placeholder="Example: ws+1, qcf+2, hcf+1" required>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label for="property" class="col-sm-2 col-form-label">Property</label>
                            <div class="col-sm-10">
                                <select id="property" class="form-select">
                                    {% for property in properties %}
                                        <option value="{{ property.name }}">{{ property.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">On block frames min</label>
                            <div class="col-sm-10">
                                <input class="form-control w-25" id="block-frames-min" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label">
                                On block frames max
                                <br>
                                (fill only if different from min)
                            </label>
                            <div class="col-sm-10">
                                <input class="form-control w-25" id="block-frames-max">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <button id="submit" class="btn btn-primary w-100">Add move</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="scripts/add-move.js"></script>
    </body>
</html>
