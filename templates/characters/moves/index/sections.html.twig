{% for section in sections.toArray() -%}
    {% if section|section_has_moves(pageType) %}
        {% set toggleId = character.slug ~ '_' ~ section.slug %}
        <h{{ level }} class="cursor-pointer{% if level > 1 or not loop.first %} mt-4{% endif %}" data-toggle data-toggle-id="{{ toggleId }}">
            {{ section.name }}
            <a href="../../../characters/{{ character.slug }}/{{ pageType }}/{{ section.id }}.html" class="text-black" title="Show only this section"><i class="bi bi-eye"></i></a>
            <i class="bi bi-link cursor-pointer" data-copy-url="characters/{{ character.slug }}/{{ pageType }}/{{ section.id }}.html" title="Copy link"></i>
            <i class="bi bi-toggle-on float-right" data-toggle-icon="{{ toggleId }}"></i>
        </h{{ level }}>

        <div data-toggle="{{ toggleId }}">
            {% for comment in section.comments.toArray() %}
                <div class="alert alert-success mt-3 mb-0" role="alert">
                    <i class="bi bi-shield-fill-check"></i>
                    {{ comment.comment|raw }}
                </div>
            {% endfor %}

            {% if section.moves.count() > 0 %}
                {% include 'characters/' ~ pageType ~ '/index/moves.html.twig' with {section: section, character: character} only %}
            {% endif %}

            {% if section.sections.count() > 0 %}
                {% include 'characters/' ~ pageType ~ '/index/sections.html.twig' with {sections: section.sections, character: character, level: level+1} only %}
            {% endif %}
        </div>
    {% endif %}
{% endfor -%}
