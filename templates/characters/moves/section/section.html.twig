<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ character.name }} - {{ section.name }} - TekkenPedia</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
        <link href="../../../styles/styles.css" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" integrity="sha384-4LISF5TTJX/fLmGSxO53rV4miRxdg84mZsxmO8Rx5jGtp/LbrixFETvWa5a6sESd" crossorigin="anonymous">
        <link rel="icon" type="image/png" href="../../../images/favicon.png" />
    </head>
    <body>
        <div class="container mb-3">
            {% set breadcrumb = [
                {
                    "href": "../../../",
                    "label": "TekkenPedia"
                },
                {
                    "href": "../../../",
                    "label": "Characters"
                },
                {
                    "href": "index.html",
                    "label": character.name
                },
                {
                    "href": "index.html",
                    "label": breadcrumbLabel
                },
                {
                    "label": section.name
                }
            ] %}
            {% include 'breadcrumb.html.twig' with {breadcrumb: breadcrumb, pathToRoot: '../../..'} only %}

            <h1>{{ section.name }}</h1>

            {% for comment in section.comments.toArray() %}
                <div class="alert alert-success mt-3 mb-0" role="alert">
                    <i class="bi bi-shield-fill-check"></i>
                    {{ comment.comment|raw }}
                </div>
            {% endfor %}

            {% if section.moves.count() > 0 %}
                {% include 'characters/' ~ pageType ~ '/index/moves.html.twig' with {section: section, character: character} only %}
            {% endif %}

            {% if section.sections.count() > 0 %}
                {% include 'characters/' ~ pageType ~ '/index/sections.html.twig' with {sections: section.sections, character: character, level: 2} only %}
            {% endif %}
        </div>

        <div id="tooltip"></div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.min.js" integrity="sha384-cuYeSxntonz0PPNlHhBs68uyIAVpIIOZZ5JqeqvYYIcEL727kskC66kF92t6Xl2V" crossorigin="anonymous"></script>
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
        <script src="../../../scripts/moves.js"></script>
    </body>
</html>
