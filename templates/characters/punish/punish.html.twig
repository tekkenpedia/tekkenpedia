<div class="{{ containerClass }}">
    <div class="card text-center">
        <div class="card-title move-card-title">
            <div class="left">
                {{ move.used|move_used }}
                {% if move.heat %}
                    <img class="icon-move-behavior" src="../../../images/behaviors/heat-engager.png" title="Heat activated">
                {% endif %}
            </div>
            <div class="title">{{ move.inputs }}</div>
            {% if showLinks is not defined or showLinks %}
                <div class="links">
                    <a href="../../../characters/{{ character.slug }}/punish/{{ move.slug }}.html" class="text-black" title="Show only this move"><i class="bi bi-eye"></i></a>
                    <i class="bi bi-link cursor-pointer" data-copy-url="characters/{{ character.slug }}/punish/{{ move.slug }}.html" title="Copy link"></i>
                    {% if copyMoveId() %}
                        <i class="bi bi-copy cursor-pointer" data-copy-move-id="{{ move.id }}" title="Copy move id"></i>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <br>
        {% if moveHasVideo(character, move, 'punish') %}
            <img src="../../../{{ getMoveVideoPath(character, move, 'punish') }}" alt="{{ move.inputs }}">
        {% endif %}

        <table class="table table-bordered table-sm mb-0">
            <tbody>
                <tr class="separator">
                    <td class="col-3">Type</td>
                    <td class="col-3">Property</td>
                    <td class="col-6">Defense</td>
                </tr>

                <tr>
                    <td>{{ move.type|move_type }}</td>
                    <td>{{ move.properties|format_move_properties }}</td>
                    <td>{{ move|move_defense() }}</td>
                </tr>

                {% if move.comments.count() > 0 %}
                    <tr class="separator">
                        <td colspan="4">Other information</td>
                    </tr>

                    {% include 'characters/punish/index/comments.html.twig' with {comments: move.comments} only %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
